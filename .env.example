# Copy to .env for local `docker compose up` testing. In GitHub
# Actions, these same names are set as repository secrets instead
# (Settings -> Secrets and variables -> Actions).

# ---- Required ----

# From YouTube Studio -> Go Live -> Stream -> "Stream key".
# Treat this like a password.
YOUTUBE_STREAM_KEY=

# ---- Optional ----

# Background audio track(s), comma-separated, looped for the life of
# the stream. YouTube requires an audio track either way — leave this
# blank and the stream will use silent audio automatically.
AUDIO_URL=

STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=24
